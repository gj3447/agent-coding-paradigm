{
  "name": "@flrh-research/langgraphjs-synthetic",
  "version": "0.0.0-proposed",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx src/runner.ts --variant variant:unknown-after-dispatch",
    "agent-smoke": "tsx src/agent-coding-runner.ts",
    "kg-dry-run": "tsx src/public-research-dry-run.ts",
    "kg-dry-run:fixture": "pnpm run kg-dry-run fixtures/public-research/synthetic-foundations.manifest.v1.json",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run smoke && pnpm run agent-smoke && pnpm run kg-dry-run:fixture"
  },
  "dependencies": {
    "@langchain/core": "1.2.5",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/openai": "1.5.6",
    "@modelcontextprotocol/client": "2.0.0",
    "effect": "3.22.1",
    "openai": "6.49.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
