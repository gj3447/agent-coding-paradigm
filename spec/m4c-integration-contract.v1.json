{
  "schema_version": "m4c-integration-contract/v1",
  "contract_version": "flrh-m4c-integration/1",
  "status": "PROPOSED_PENDING_MEASUREMENT",
  "profile_id": "flrh-m4c-single-effect-reference/1",
  "purpose": "Bind one live public F to L to LR to R to M4A to M4B reference path and independently verify exact cross-stage lineage without asserting outer-run completion.",
  "pipeline": [
    "flrh_kernel.step_f",
    "flrh_logic.solve_l",
    "flrh_lr_seam.project_lr",
    "flrh_reactive.step_r",
    "flrh_authority.project_h_intent",
    "flrh_harness.DurableHarness"
  ],
  "fsm_projection": {
    "source": "spec/run-fsm.v1.json",
    "transitions": [
      {"from": "INIT", "event": "START", "to": "INGEST"},
      {"from": "INGEST", "event": "EVENT_ACCEPTED", "to": "STABILIZE"},
      {"from": "STABILIZE", "event": "EPOCH_STABLE", "to": "PLAN_EFFECTS"},
      {"from": "PLAN_EFFECTS", "event": "EFFECT_AUTHORIZED", "to": "COMMIT_INTENT"},
      {"from": "COMMIT_INTENT", "event": "INTENT_COMMITTED", "to": "EXECUTE"},
      {"from": "EXECUTE", "event": "ATTEMPT_RECORDED", "to": "RECONCILE"},
      {"from": "RECONCILE", "event": "EFFECT_RESULT_CONFIRMED", "to": "HONOR_PENDING_INTERRUPT"}
    ],
    "trace_claim": "FSM_CONFORMANCE_PROJECTION_ONLY",
    "outer_reducer_executed": false,
    "stop_state": "HONOR_PENDING_INTERRUPT",
    "terminal_claim": "SLICE_CONFORMED"
  },
  "constraints": {
    "prior_materialization_must_be_null": true,
    "adapter_profile": "FakeAdapter",
    "max_pending_intents": 1,
    "max_attempts_per_intent": 3,
    "r_frontier_rule": "strictly_greater_than_epoch",
    "demand_batches": 1
  },
  "verification": {
    "public_api_only": true,
    "independent_verifier": "scripts/m4c_verifier.py",
    "checks": [
      "public_f_reexecution",
      "public_l_reexecution",
      "public_lr_reexecution",
      "public_r_reexecution",
      "public_h_reexecution",
      "exact_action_receipt_schema_and_binding",
      "detached_durable_consistency_receipt",
      "source_bound_fsm_evidence_projection",
      "real_subprocess_crash_recovery_when_selected"
    ],
    "crash_profile": "after_external_success_then_query_reconcile_without_second_mutation"
  },
  "typed_failure": {
    "kind": "M4CVerificationFailure",
    "code": "INTEGRATION_BINDING_MISMATCH",
    "state_preserving": true
  },
  "non_claims": [
    "outer FSM SUCCEEDED or full run completion",
    "persistent incremental L reuse",
    "general eligibility correctness",
    "multi-effect scheduling",
    "receipt reingestion into F",
    "real destination safety or exactly-once delivery",
    "integrated production runtime",
    "engine promotion",
    "comparative efficacy or Lakatos progress"
  ],
  "completion_boundary": "PROPOSED only; one deterministic singleton public reference chain over full-recompute L and FakeAdapter, ending at HONOR_PENDING_INTERRUPT with SLICE_CONFORMED. M4A and M4B remain separately proposed, the durable run remains active, and no production, engine, efficacy, scientific-progress, or outer-completion claim is made."
}
