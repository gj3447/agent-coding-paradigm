{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/run-fsm-traces.v1.schema.json",
  "title": "FLR-H FSM trace fixtures v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coverage_claim", "cases"],
  "properties": {
    "schema_version": {"const": "flrh-run-fsm-traces/v1"},
    "coverage_claim": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "machine", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "machine": {"const": "control"},
          "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "guard_results", "expected_state", "expected_effects"],
      "properties": {
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "actor_role", "capability", "event_id", "payload"],
          "properties": {
            "type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "actor_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
            "event_id": {"type": "string", "minLength": 1},
            "payload": {"type": "object"}
          }
        },
        "guard_results": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": "boolean"}
        },
        "expected_state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "expected_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}}
      }
    }
  }
}
