{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/agent-source-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "epistemic_status", "measurement_scope", "observation", "selection", "sources"],
  "properties": {
    "schema_version": {"const": "agent-source-registry/v1"},
    "epistemic_status": {"const": "MEASURED"},
    "measurement_scope": {"const": "GitHub REST repository metadata observed at one UTC instant; not quality, adoption, efficacy, or legal-review evidence"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "provider", "command", "environment", "receipt"],
      "properties": {
        "observed_at": {"const": "2026-08-11T09:48:34Z"},
        "provider": {"const": "GitHub REST API"},
        "command": {"const": "gh api repos/{owner}/{repo}; gh api repos/{owner}/{repo}/commits/{default_branch}"},
        "environment": {"const": "Linux 7.0.14-5-pve x86_64; gh 2.97.0"},
        "receipt": {"const": "research/AGENT_CODING_SOURCE_SNAPSHOT_2026-08-11.md"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "exhaustive", "stars_are_quality_evidence", "vendoring"],
      "properties": {
        "method": {"const": "non-exhaustive popularity-and-mechanism sample plus coding-agent evaluation sources"},
        "exhaustive": {"const": false},
        "stars_are_quality_evidence": {"const": false},
        "vendoring": {"const": false}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "category", "repository", "url", "default_branch", "head_sha", "head_committed_at", "license_spdx", "archived", "stars", "forks", "reusable_mechanisms", "boundary_notes", "integration_mode"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^source:github:[a-z0-9][a-z0-9-]*$"},
        "category": {"enum": ["coding_agent", "runtime_comparator", "protocol", "evaluation"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "default_branch": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_committed_at": {"type": "string", "format": "date-time"},
        "license_spdx": {"enum": ["Apache-2.0", "MIT"]},
        "archived": {"const": false},
        "stars": {"type": "integer", "minimum": 0},
        "forks": {"type": "integer", "minimum": 0},
        "reusable_mechanisms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "boundary_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "integration_mode": {"const": "reference_only"}
      }
    }
  }
}
