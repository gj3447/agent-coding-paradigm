      "properties": {"kind": {"const": "LBaseSupport"}, "derivation_id": {"type": "string"}, "support_content_digest": {"$ref": "#/$defs/Digest"}, "literal": {"$ref": "#/$defs/Literal"}, "provenance_delta": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}}, "rule_set_version": {"type": "string"}, "dataflow_version": {"type": "string"}}
    },
    "FactState": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fact_key", "atom", "state", "positive_support_ids", "negative_support_ids"],
      "properties": {"kind": {"const": "LFactState"}, "fact_key": {"$ref": "#/$defs/Digest"}, "atom": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}}, "state": {"enum": ["NEITHER", "TRUE_ONLY", "FALSE_ONLY", "BOTH"]}, "positive_support_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "negative_support_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    },
    "Conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "conflict_id", "fact_key", "atom", "positive_support_ids", "negative_support_ids"],
      "properties": {"kind": {"const": "LConflict"}, "conflict_id": {"type": "string"}, "fact_key": {"$ref": "#/$defs/Digest"}, "atom": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}}, "positive_support_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "negative_support_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
    },
    "StratumDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "stratum", "digest"],
      "properties": {"kind": {"const": "LStratumDigest"}, "stratum": {"$ref": "#/$defs/Count"}, "digest": {"$ref": "#/$defs/Digest"}}
    },
    "DerivedFactDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "polarity", "delta"],
      "properties": {"kind": {"const": "LFactDeltaInput"}, "schema_version": {"const": "flrh-l-input/1"}, "polarity": {"enum": ["positive", "negative"]}, "delta": {"type": "object", "additionalProperties": false, "required": ["kind", "tuple", "logical_time", "diff", "derivation_id", "causation_id", "provenance_delta", "rule_set_version", "dataflow_version"], "properties": {"kind": {"const": "FactDelta"}, "tuple": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}}, "logical_time": {"$ref": "#/$defs/Time"}, "diff": {"enum": [-1, 1]}, "derivation_id": {"type": "string"}, "causation_id": {"type": "string"}, "provenance_delta": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}}, "rule_set_version": {"type": "string"}, "dataflow_version": {"type": "string"}}}}
    },
    "RequiredPresence": {
      "type": "object", "additionalProperties": false,
      "required": ["literal_key", "present", "depth"],
      "properties": {"literal_key": {"$ref": "#/$defs/Digest"}, "present": {"type": "boolean"}, "depth": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Count"}]}}
    },
    "DefaultPresence": {
      "type": "object", "additionalProperties": false,
      "required": ["positive_literal_key", "positive_present", "referenced_stratum", "completed_lower_stratum_digest"],
      "properties": {"positive_literal_key": {"$ref": "#/$defs/Digest"}, "positive_present": {"type": "boolean"}, "referenced_stratum": {"$ref": "#/$defs/Count"}, "completed_lower_stratum_digest": {"$ref": "#/$defs/Digest"}}
