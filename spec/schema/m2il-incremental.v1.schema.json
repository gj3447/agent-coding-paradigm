{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2il-incremental.v1.schema.json",
  "title": "Closed M2-IL public wire values",
  "oneOf": [
    {"$ref": "#/$defs/LPersistentLStep"},
    {"$ref": "#/$defs/LPersistentLRejection"},
    {"$ref": "#/$defs/LRejection"}
  ],
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Time": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "Count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "Canonical": {
      "oneOf": [
        {"type": "null"}, {"type": "boolean"},
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/Canonical"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/Canonical"}}
      ]
    },
    "Literal": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "polarity", "atom"],
      "properties": {"kind": {"const": "LLiteral"}, "polarity": {"enum": ["positive", "negative"]}, "atom": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}}}
    },
    "AbsenceWitness": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fact_key", "atom", "referenced_stratum", "completed_stratum_digest", "witness_digest"],
      "properties": {"kind": {"const": "LAbsenceWitness"}, "fact_key": {"$ref": "#/$defs/Digest"}, "atom": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}}, "referenced_stratum": {"$ref": "#/$defs/Count"}, "completed_stratum_digest": {"$ref": "#/$defs/Digest"}, "witness_digest": {"$ref": "#/$defs/Digest"}}
    },
    "DerivedSupport": {
