        {"type": "object", "additionalProperties": false, "required": ["status", "depth", "support"], "properties": {"status": {"const": "satisfied"}, "depth": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "support": {"$ref": "#/$defs/DerivedSupport"}}}
