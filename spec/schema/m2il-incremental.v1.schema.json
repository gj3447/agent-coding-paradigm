      "type": "object", "additionalProperties": false,
      "required": ["kind", "rule_id", "rule_digest", "rule_bundle_digest", "stratum", "trigger", "existing_support", "required_literals", "default_positive_presence"],
      "properties": {"kind": {"const": "M2ILCacheContext"}, "rule_id": {"type": "string"}, "rule_digest": {"$ref": "#/$defs/Digest"}, "rule_bundle_digest": {"$ref": "#/$defs/Digest"}, "stratum": {"$ref": "#/$defs/Count"}, "trigger": {"type": "string"}, "existing_support": {"type": "boolean"}, "required_literals": {"type": "array", "items": {"$ref": "#/$defs/RequiredPresence"}}, "default_positive_presence": {"type": "array", "items": {"$ref": "#/$defs/DefaultPresence"}}}
    },
    "CacheOutcome": {
