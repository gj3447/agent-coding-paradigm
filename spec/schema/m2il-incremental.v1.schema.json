      "properties": {"kind": {"const": "LDerivedSupport"}, "derivation_id": {"type": "string"}, "support_content_digest": {"$ref": "#/$defs/Digest"}, "literal": {"$ref": "#/$defs/Literal"}, "rule_id": {"type": "string"}, "rule_digest": {"$ref": "#/$defs/Digest"}, "premise_literal_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Digest"}}, "default_absence_witnesses": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/AbsenceWitness"}}, "rule_set_version": {"type": "string"}, "dataflow_version": {"type": "string"}}
    },
    "BaseSupport": {
      "type": "object", "additionalProperties": false,
