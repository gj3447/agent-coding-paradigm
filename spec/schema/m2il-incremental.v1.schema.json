      "properties": {"kind": {"const": "LMaterialization"}, "schema_version": {"const": "flrh-l-materialization/1"}, "contract_version": {"const": "flrh-l-kernel/1"}, "profile_id": {"const": "flrh-l-ground-stratified/1"}, "rule_bundle_digest": {"$ref": "#/$defs/Digest"}, "rule_set_version": {"type": "string"}, "dataflow_version": {"type": "string"}, "canonicalization_version": {"const": "flrh-cjson/1"}, "through_logical_time": {"$ref": "#/$defs/Time"}, "base_supports": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/BaseSupport"}}, "derived_supports": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/DerivedSupport"}}, "fact_states": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/FactState"}}, "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Conflict"}}, "stratum_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/StratumDigest"}}, "materialization_digest": {"$ref": "#/$defs/Digest"}}
    },
    "Fixpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "logical_time", "rule_bundle_digest", "prior_materialization_digest", "input_delta_digests", "next_materialization", "derived_fact_deltas", "stats", "fixpoint_digest"],
      "properties": {"kind": {"const": "LFixpointResult"}, "schema_version": {"const": "flrh-l-result/1"}, "contract_version": {"const": "flrh-l-kernel/1"}, "logical_time": {"$ref": "#/$defs/Time"}, "rule_bundle_digest": {"$ref": "#/$defs/Digest"}, "prior_materialization_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Digest"}]}, "input_delta_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Digest"}}, "next_materialization": {"$ref": "#/$defs/Materialization"}, "derived_fact_deltas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/DerivedFactDelta"}}, "stats": {"type": "object", "additionalProperties": false, "required": ["evaluation_mode", "rule_evaluation_count", "rule_firing_count", "worklist_pop_count", "max_derivation_depth"], "properties": {"evaluation_mode": {"const": "full_recompute"}, "rule_evaluation_count": {"$ref": "#/$defs/Count"}, "rule_firing_count": {"$ref": "#/$defs/Count"}, "worklist_pop_count": {"$ref": "#/$defs/Count"}, "max_derivation_depth": {"$ref": "#/$defs/Count"}}}, "fixpoint_digest": {"$ref": "#/$defs/Digest"}}
    },
    "Checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "profile_id", "m2_contract_version", "m2_profile_id", "canonicalization_version", "rule_bundle_digest", "through_logical_time", "materialization", "materialization_digest", "evaluation_cache", "checkpoint_digest"],
      "properties": {"kind": {"const": "LPersistentLCheckpoint"}, "schema_version": {"const": "flrh-l-persistent-checkpoint/1"}, "contract_version": {"const": "flrh-l-persistent-incremental/1"}, "profile_id": {"const": "flrh-l-persistent-incremental/1"}, "m2_contract_version": {"const": "flrh-l-kernel/1"}, "m2_profile_id": {"const": "flrh-l-ground-stratified/1"}, "canonicalization_version": {"const": "flrh-cjson/1"}, "rule_bundle_digest": {"$ref": "#/$defs/Digest"}, "through_logical_time": {"$ref": "#/$defs/Time"}, "materialization": {"$ref": "#/$defs/Materialization"}, "materialization_digest": {"$ref": "#/$defs/Digest"}, "evaluation_cache": {"type": "array", "maxItems": 65536, "uniqueItems": true, "items": {"$ref": "#/$defs/CacheEntry"}}, "checkpoint_digest": {"$ref": "#/$defs/Digest"}}
    },
    "Receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "prior_checkpoint_digest", "next_checkpoint_digest", "oracle_fixpoint_digest", "candidate_fixpoint_digest", "public_m2_solve_calls", "candidate_cache_lookups", "candidate_cache_hits", "candidate_cache_misses", "reused_candidate_body_evaluations", "executed_candidate_body_evaluations", "accounted_candidate_body_evaluations", "reused_entry_digests", "receipt_digest"],
      "properties": {"kind": {"const": "M2ILReuseReceipt"}, "prior_checkpoint_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Digest"}]}, "next_checkpoint_digest": {"$ref": "#/$defs/Digest"}, "oracle_fixpoint_digest": {"$ref": "#/$defs/Digest"}, "candidate_fixpoint_digest": {"$ref": "#/$defs/Digest"}, "public_m2_solve_calls": {"const": 2}, "candidate_cache_lookups": {"$ref": "#/$defs/Count"}, "candidate_cache_hits": {"$ref": "#/$defs/Count"}, "candidate_cache_misses": {"$ref": "#/$defs/Count"}, "reused_candidate_body_evaluations": {"$ref": "#/$defs/Count"}, "executed_candidate_body_evaluations": {"$ref": "#/$defs/Count"}, "accounted_candidate_body_evaluations": {"$ref": "#/$defs/Count"}, "reused_entry_digests": {"type": "array", "items": {"$ref": "#/$defs/Digest"}}, "receipt_digest": {"$ref": "#/$defs/Digest"}}
    },
    "LPersistentLStep": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "fixpoint_result", "next_checkpoint", "reuse_receipt", "step_digest"],
      "properties": {"kind": {"const": "LPersistentLStep"}, "schema_version": {"const": "flrh-l-persistent-result/1"}, "contract_version": {"const": "flrh-l-persistent-incremental/1"}, "fixpoint_result": {"$ref": "#/$defs/Fixpoint"}, "next_checkpoint": {"$ref": "#/$defs/Checkpoint"}, "reuse_receipt": {"$ref": "#/$defs/Receipt"}, "step_digest": {"$ref": "#/$defs/Digest"}}
    },
    "LPersistentLRejection": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "code", "path", "logical_time", "rule_bundle_digest", "context"],
      "properties": {"kind": {"const": "LPersistentLRejection"}, "schema_version": {"const": "flrh-l-persistent-result/1"}, "contract_version": {"const": "flrh-l-persistent-incremental/1"}, "code": {"enum": ["UNSUPPORTED_PERSISTENT_SCHEMA", "MALFORMED_CHECKPOINT", "CHECKPOINT_DIGEST_MISMATCH", "CHECKPOINT_BINDING_MISMATCH", "PERSISTENT_BOUNDS_EXCEEDED", "EQUIVALENCE_VIOLATION"]}, "path": {"type": "string", "pattern": "^/"}, "logical_time": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Time"}]}, "rule_bundle_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Digest"}]}, "context": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Canonical"}}}
    },
    "LRejection": {
      "type": "object", "required": ["kind", "schema_version", "contract_version", "code", "path", "logical_time", "rule_bundle_digest", "context"],
      "properties": {"kind": {"const": "LRejection"}, "schema_version": {"const": "flrh-l-result/1"}, "contract_version": {"const": "flrh-l-kernel/1"}, "code": {"enum": ["MALFORMED_MATERIALIZATION", "MALFORMED_RULE_BUNDLE", "MALFORMED_FACT_DELTA_INPUT", "CANONICALIZATION_VIOLATION", "UNSUPPORTED_CONTRACT_VERSION", "UNSUPPORTED_PROFILE", "UNSUPPORTED_MATERIALIZATION_SCHEMA", "UNSUPPORTED_RULE_SCHEMA", "UNSUPPORTED_INPUT_SCHEMA", "UNSUPPORTED_CANONICALIZATION", "RULE_SET_VERSION_MISMATCH", "DATAFLOW_VERSION_MISMATCH", "RULE_BUNDLE_MISMATCH", "LOGICAL_TIME_MISMATCH", "LOGICAL_TIME_REGRESSION", "INVALID_STRATIFICATION", "OUTSIDE_V0_NEGATIVE_RECURSION", "AMBIGUOUS_BATCH_DELTA", "UNKNOWN_DERIVATION", "DERIVATION_IDENTITY_CONFLICT", "DERIVED_SUPPORT_TARGET", "PROVENANCE_INTEGRITY_VIOLATION", "RULE_BUDGET_EXHAUSTED", "DERIVATION_DEPTH_EXCEEDED", "INVARIANT_VIOLATION"]}, "path": {"type": "string", "pattern": "^(/([^/~]|~[01])*)*$"}, "logical_time": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Time"}]}, "rule_bundle_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Digest"}]}, "context": {"type": "object", "additionalProperties": false, "properties": {"expected": {"$ref": "#/$defs/Canonical"}, "actual": {"$ref": "#/$defs/Canonical"}, "derivation_id": {"type": "string"}, "rule_id": {"type": "string"}, "invariant": {"type": "string", "minLength": 1}, "limit": {"$ref": "#/$defs/Count"}, "observed": {"$ref": "#/$defs/Count"}, "source_stratum": {"$ref": "#/$defs/Count"}, "target_stratum": {"$ref": "#/$defs/Count"}, "support_content_digest": {"$ref": "#/$defs/Digest"}}}}, "additionalProperties": false
    }
  }
}
