{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/engine-decision.v1.schema.json",
  "title": "Engine or module decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "verdict",
    "purpose",
    "current_consumers",
    "planned_consumers",
    "rationale",
    "boundary",
    "contract",
    "invariants",
    "failure_model",
    "verification",
    "promotion_gates",
    "falsifiers"
  ],
  "properties": {
    "schema_version": {"const": "engine-decision/v1"},
    "name": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["module", "defer", "engine"]},
    "purpose": {"type": "string", "minLength": 1},
    "current_consumers": {"$ref": "#/$defs/nonEmptyStrings"},
    "planned_consumers": {"$ref": "#/$defs/nonEmptyStrings"},
    "rationale": {"$ref": "#/$defs/nonEmptyStrings"},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "mechanism", "policy_outside", "non_goals", "state_authority"],
      "properties": {
        "owns": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "policy_outside": {"$ref": "#/$defs/nonEmptyStrings"},
        "non_goals": {"$ref": "#/$defs/nonEmptyStrings"},
        "state_authority": {"type": "string", "minLength": 1}
      }
    },
    "contract": {"type": "string", "minLength": 1},
    "invariants": {"$ref": "#/$defs/nonEmptyStrings"},
    "failure_model": {"$ref": "#/$defs/nonEmptyStrings"},
    "verification": {"$ref": "#/$defs/nonEmptyStrings"},
    "promotion_gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/promotionGate"}
    },
    "falsifiers": {"$ref": "#/$defs/nonEmptyStrings"}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "threshold", "unit"],
      "properties": {
        "metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "operator": {"enum": [">=", "<=", "==", ">", "<"]},
        "threshold": {
          "oneOf": [
            {"type": "number"},
            {"type": "string", "minLength": 1},
            {"type": "boolean"}
          ]
        },
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "criterion", "status", "measurements", "evidence", "prerequisites"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "criterion": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "BLOCKED", "PASSED", "FAILED"]},
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/measurement"}
        },
        "evidence": {"$ref": "#/$defs/strings"},
        "prerequisites": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
