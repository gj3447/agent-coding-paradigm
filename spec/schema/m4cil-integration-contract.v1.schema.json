{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m4cil-integration-contract.v1.schema.json",
  "title": "M4C-IL bounded incremental integration contract and evidence wires",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "status", "profile_id", "purpose", "pipeline", "incremental_lineage", "fsm_projection", "constraints", "verification", "typed_failures", "non_claims", "completion_boundary"],
  "properties": {
    "schema_version": {"const": "m4cil-integration-contract/v1"},
    "contract_version": {"const": "flrh-m4cil-integration/1"},
    "status": {"const": "PROPOSED_PENDING_MEASUREMENT"},
    "profile_id": {"const": "flrh-m4cil-single-effect-incremental-reference/1"},
    "purpose": {"const": "Bind one live public F to two-prefix persistent incremental L to LR to R to M4A to M4B reference path, including real checkpoint reuse and crash reconciliation, without asserting outer-run completion."},
    "pipeline": {"const": ["flrh_kernel.step_f", "flrh_logic_incremental.step_incremental_l.bootstrap", "flrh_logic_incremental.step_incremental_l.reuse", "flrh_lr_seam.project_lr", "flrh_reactive.step_r", "flrh_authority.project_h_intent", "flrh_harness.DurableHarness"]},
    "incremental_lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["bootstrap_prior_checkpoint", "bootstrap_logical_time", "reuse_logical_time", "reuse_input_deltas", "minimum_candidate_cache_hits", "maximum_reuse_candidate_body_evaluations", "public_m2_solve_calls_per_incremental_step", "public_m2_calls_excluded_from_candidate_counters", "lr_input"],
      "properties": {
        "bootstrap_prior_checkpoint": {"type": "null"},
        "bootstrap_logical_time": {"const": 1},
        "reuse_logical_time": {"const": 2},
        "reuse_input_deltas": {"const": []},
        "minimum_candidate_cache_hits": {"const": 1},
        "maximum_reuse_candidate_body_evaluations": {"const": 0},
        "public_m2_solve_calls_per_incremental_step": {"const": 2},
        "public_m2_calls_excluded_from_candidate_counters": {"const": true},
        "lr_input": {"const": "reuse_logic_step.fixpoint_result"}
      }
    },
    "fsm_projection": {"$ref": "#/$defs/FSMProjection"},
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_profile", "max_pending_intents", "max_attempts_per_intent", "r_frontier_rule", "demand_batches", "crash_point", "crash_worker_exit_code"],
      "properties": {
        "adapter_profile": {"const": "FakeAdapter"},
        "max_pending_intents": {"const": 1},
        "max_attempts_per_intent": {"const": 3},
        "r_frontier_rule": {"const": "strictly_greater_than_final_incremental_epoch"},
        "demand_batches": {"const": 1},
        "crash_point": {"const": "after_external_success"},
        "crash_worker_exit_code": {"const": 86}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["independent_verifier", "source_reexecution", "checks", "sensitivity_cases", "clean_processes"],
      "properties": {
        "independent_verifier": {"const": "scripts/m4cil_verifier.py"},
        "source_reexecution": {"const": true},
        "checks": {"const": ["public_f_reexecution", "public_incremental_l_bootstrap_reexecution", "public_incremental_l_checkpoint_reuse_reexecution", "incremental_checkpoint_lineage", "exact_m2_compatible_fixpoint_to_lr_binding", "public_lr_r_h_reexecution", "durable_checkpoint_incremental_lineage", "exact_action_receipt_binding", "source_derived_fsm_evidence_projection", "real_subprocess_crash_recovery_when_selected"]},
        "sensitivity_cases": {"const": 16},
        "clean_processes": {"const": 4}
      }
    },
    "typed_failures": {"const": ["M4CILReplayRejection", "M4CILVerificationFailure"]},
    "non_claims": {"const": ["outer FSM SUCCEEDED or full run completion", "general persistent incremental runtime", "filesystem or database persistence for L checkpoints", "reduced total runtime or performance superiority", "multi-event or multi-effect scheduling", "durable R state", "real destination safety or exactly-once delivery", "integrated production runtime", "engine promotion", "comparative efficacy or Lakatos progress"]},
    "completion_boundary": {"const": "PROPOSED only; a bounded two-prefix M2-IL checkpoint-reuse path feeds its exact M2-compatible fixpoint into the existing LR to R to H to durable crash/reconcile reference path. It ends at HONOR_PENDING_INTERRUPT with SLICE_CONFORMED and makes no performance, persistence, production, engine, efficacy, scientific-progress, or outer-completion claim."}
  },
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "Id": {"type": "string", "minLength": 1, "maxLength": 256},
    "Canonical": {
      "oneOf": [
        {"type": "null"}, {"type": "boolean"},
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/Canonical"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/Canonical"}}
      ]
    },
    "StageObject": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/Canonical"}},
    "TransitionShape": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "event", "to"],
      "properties": {"from": {"type": "string"}, "event": {"type": "string"}, "to": {"type": "string"}}
    },
    "FSMProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "transitions", "trace_claim", "outer_reducer_executed", "stop_state", "terminal_claim"],
      "properties": {
        "source": {"const": "spec/run-fsm.v1.json"},
        "transitions": {"const": [
          {"from": "INIT", "event": "START", "to": "INGEST"},
          {"from": "INGEST", "event": "EVENT_ACCEPTED", "to": "STABILIZE"},
          {"from": "STABILIZE", "event": "EPOCH_STABLE", "to": "PLAN_EFFECTS"},
          {"from": "PLAN_EFFECTS", "event": "EFFECT_AUTHORIZED", "to": "COMMIT_INTENT"},
          {"from": "COMMIT_INTENT", "event": "INTENT_COMMITTED", "to": "EXECUTE"},
          {"from": "EXECUTE", "event": "ATTEMPT_RECORDED", "to": "RECONCILE"},
          {"from": "RECONCILE", "event": "EFFECT_RESULT_CONFIRMED", "to": "HONOR_PENDING_INTERRUPT"}
        ]},
        "trace_claim": {"const": "FSM_CONFORMANCE_PROJECTION_ONLY"},
        "outer_reducer_executed": {"const": false},
        "stop_state": {"const": "HONOR_PENDING_INTERRUPT"},
        "terminal_claim": {"const": "SLICE_CONFORMED"}
      }
    },
    "TraceSource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "authority", "machine_id"],
      "properties": {
        "path": {"const": "spec/run-fsm.v1.json"}, "sha256": {"$ref": "#/$defs/Digest"},
        "schema_version": {"const": "flrh-run-fsm/v1"},
        "authority": {"const": "sole-authoritative-outer-control-fsm"}, "machine_id": {"const": "control"}
      }
    },
    "DurableCheckpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "stage", "projection_digest", "bootstrap_step_digest", "bootstrap_checkpoint_digest", "reuse_step_digest", "logic_fixpoint_digest", "logic_checkpoint"],
      "properties": {
        "kind": {"const": "M4CILCheckpoint"}, "stage": {"const": "authority_projected"},
        "projection_digest": {"$ref": "#/$defs/Digest"}, "bootstrap_step_digest": {"$ref": "#/$defs/Digest"},
        "bootstrap_checkpoint_digest": {"$ref": "#/$defs/Digest"}, "reuse_step_digest": {"$ref": "#/$defs/Digest"},
        "logic_fixpoint_digest": {"$ref": "#/$defs/Digest"},
        "logic_checkpoint": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2il-incremental.v1.schema.json#/$defs/Checkpoint"}
      }
    },
    "DurableCheckpointReadback": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "stage", "projection_digest", "bootstrap_step_digest", "bootstrap_checkpoint_digest", "reuse_step_digest", "logic_fixpoint_digest", "logic_checkpoint", "last_committed_intent_id", "last_receipt_digest"],
      "properties": {
        "kind": {"const": "M4CILCheckpoint"}, "stage": {"const": "authority_projected"},
        "projection_digest": {"$ref": "#/$defs/Digest"}, "bootstrap_step_digest": {"$ref": "#/$defs/Digest"},
        "bootstrap_checkpoint_digest": {"$ref": "#/$defs/Digest"}, "reuse_step_digest": {"$ref": "#/$defs/Digest"},
        "logic_fixpoint_digest": {"$ref": "#/$defs/Digest"},
        "logic_checkpoint": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2il-incremental.v1.schema.json#/$defs/Checkpoint"},
        "last_committed_intent_id": {"$ref": "#/$defs/Id"}, "last_receipt_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "ReceiptBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["command_digest", "input_root_digest", "platform_digest"],
      "properties": {"command_digest": {"$ref": "#/$defs/Digest"}, "input_root_digest": {"$ref": "#/$defs/Digest"}, "platform_digest": {"$ref": "#/$defs/Digest"}}
    },
    "Verification": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "run_id", "valid", "errors", "intent_count", "receipt_count", "pending_count"],
      "properties": {
        "kind": {"const": "M4BVerificationReport"}, "run_id": {"$ref": "#/$defs/Id"}, "valid": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}}, "intent_count": {"$ref": "#/$defs/Count"},
        "receipt_count": {"$ref": "#/$defs/Count"}, "pending_count": {"$ref": "#/$defs/Count"}
      }
    },
    "AdapterCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["apply_count", "query_count", "mutation_count"],
      "properties": {"apply_count": {"$ref": "#/$defs/Count"}, "query_count": {"$ref": "#/$defs/Count"}, "mutation_count": {"$ref": "#/$defs/Count"}}
    },
    "Recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["crash_point", "process_model", "worker_exit_code", "worker_payload_digest", "mutation_count_at_crash", "pre_recovery_verification", "reopen_epoch", "reconciliation_result"],
      "properties": {
        "crash_point": {"const": "after_external_success"}, "process_model": {"const": "subprocess_os_exit_reopen"},
        "worker_exit_code": {"const": 86}, "worker_payload_digest": {"$ref": "#/$defs/Digest"},
        "mutation_count_at_crash": {"const": 1}, "pre_recovery_verification": {"$ref": "#/$defs/Verification"},
        "reopen_epoch": {"const": 111}, "reconciliation_result": {"const": "confirmed_success"}
      }
    },
    "TraceRow": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "from", "event", "to", "authority", "guard", "evidence"],
      "properties": {
        "transition_id": {"type": "string"}, "from": {"type": "string"}, "event": {"type": "string"}, "to": {"type": "string"},
        "authority": {"$ref": "#/$defs/StageObject"}, "guard": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/StageObject"}]},
        "evidence": {"$ref": "#/$defs/StageObject"}
      }
    },
    "ReplayEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "profile_id", "replay_mode", "status", "outer_fsm_stop_state", "trace_claim", "outer_reducer_executed", "trace_source", "adapter_profile", "accepted_event", "f_transition", "rule_bundle", "bootstrap_input_deltas", "bootstrap_logic_step", "reuse_input_deltas", "reuse_logic_step", "binding_profile", "query_batch", "lr_projection", "r_profile", "r_apply_transition", "r_equal_frontier_transitions", "r_passed_frontier_transitions", "r_publish_transition", "r_published_batch", "h_command", "h_projection", "durable_checkpoint", "durable_checkpoint_readback", "receipt_binding", "action_receipt", "m4b_verification", "durable_run_status", "adapter_counts", "recovery", "trace", "evidence_digest"],
      "properties": {
        "kind": {"const": "M4CILReplayEvidence"}, "schema_version": {"const": "flrh-m4cil-replay/1"},
        "contract_version": {"const": "flrh-m4cil-integration/1"}, "profile_id": {"const": "flrh-m4cil-single-effect-incremental-reference/1"},
        "replay_mode": {"enum": ["happy", "crash_after_external_success"]}, "status": {"const": "SLICE_CONFORMED"},
        "outer_fsm_stop_state": {"const": "HONOR_PENDING_INTERRUPT"}, "trace_claim": {"const": "FSM_CONFORMANCE_PROJECTION_ONLY"},
        "outer_reducer_executed": {"const": false}, "trace_source": {"$ref": "#/$defs/TraceSource"}, "adapter_profile": {"const": "FakeAdapter"},
        "accepted_event": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/AcceptedEvent"},
        "f_transition": {"$ref": "#/$defs/StageObject"}, "rule_bundle": {"$ref": "#/$defs/StageObject"},
        "bootstrap_input_deltas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/StageObject"}},
        "bootstrap_logic_step": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2il-incremental.v1.schema.json#/$defs/LPersistentLStep"},
        "reuse_input_deltas": {"const": []},
        "reuse_logic_step": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2il-incremental.v1.schema.json#/$defs/LPersistentLStep"},
        "binding_profile": {"$ref": "#/$defs/StageObject"}, "query_batch": {"$ref": "#/$defs/StageObject"}, "lr_projection": {"$ref": "#/$defs/StageObject"},
        "r_profile": {"$ref": "#/$defs/StageObject"}, "r_apply_transition": {"$ref": "#/$defs/StageObject"},
        "r_equal_frontier_transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/StageObject"}},
        "r_passed_frontier_transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/StageObject"}},
        "r_publish_transition": {"$ref": "#/$defs/StageObject"}, "r_published_batch": {"$ref": "#/$defs/StageObject"},
        "h_command": {"$ref": "#/$defs/StageObject"}, "h_projection": {"$ref": "#/$defs/StageObject"},
        "durable_checkpoint": {"$ref": "#/$defs/DurableCheckpoint"}, "durable_checkpoint_readback": {"$ref": "#/$defs/DurableCheckpointReadback"},
        "receipt_binding": {"$ref": "#/$defs/ReceiptBinding"},
        "action_receipt": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/ActionReceipt"},
        "m4b_verification": {"$ref": "#/$defs/Verification"}, "durable_run_status": {"const": "active"},
        "adapter_counts": {"$ref": "#/$defs/AdapterCounts"},
        "recovery": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Recovery"}]},
        "trace": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/TraceRow"}},
        "evidence_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "ReplayRejection": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "code", "path", "stage", "upstream_rejection", "context", "rejection_digest"],
      "properties": {
        "kind": {"const": "M4CILReplayRejection"}, "schema_version": {"const": "flrh-m4cil-replay/1"}, "contract_version": {"const": "flrh-m4cil-integration/1"},
        "code": {"const": "UPSTREAM_STAGE_REJECTION"}, "path": {"type": "string", "pattern": "^/"}, "stage": {"type": "string", "minLength": 1},
        "upstream_rejection": {"$ref": "#/$defs/Canonical"}, "context": {"type": "object", "maxProperties": 0}, "rejection_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "VerificationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "status", "outer_fsm_stop_state", "stage_digests", "checks", "verification_digest"],
      "properties": {
        "kind": {"const": "M4CILVerificationReceipt"}, "schema_version": {"const": "flrh-m4cil-verification/1"}, "contract_version": {"const": "flrh-m4cil-integration/1"},
        "status": {"const": "SLICE_CONFORMED"}, "outer_fsm_stop_state": {"const": "HONOR_PENDING_INTERRUPT"},
        "stage_digests": {
          "type": "object", "additionalProperties": false,
          "required": ["action_receipt", "bootstrap_checkpoint", "bootstrap_step", "f_transition", "h_projection", "l_fixpoint", "lr_projection", "r_published_batch", "replay_evidence", "reuse_checkpoint", "reuse_step"],
          "properties": {
            "action_receipt": {"$ref": "#/$defs/Digest"}, "bootstrap_checkpoint": {"$ref": "#/$defs/Digest"},
            "bootstrap_step": {"$ref": "#/$defs/Digest"}, "f_transition": {"$ref": "#/$defs/Digest"},
            "h_projection": {"$ref": "#/$defs/Digest"}, "l_fixpoint": {"$ref": "#/$defs/Digest"},
            "lr_projection": {"$ref": "#/$defs/Digest"}, "r_published_batch": {"$ref": "#/$defs/Digest"},
            "replay_evidence": {"$ref": "#/$defs/Digest"}, "reuse_checkpoint": {"$ref": "#/$defs/Digest"},
            "reuse_step": {"$ref": "#/$defs/Digest"}
          }
        },
        "checks": {"const": ["public_f_reexecution", "public_incremental_l_bootstrap_reexecution", "public_incremental_l_checkpoint_reuse_reexecution", "incremental_checkpoint_lineage", "exact_m2_compatible_fixpoint_to_lr_binding", "public_lr_r_h_reexecution", "durable_checkpoint_incremental_lineage", "exact_action_receipt_binding", "source_derived_fsm_evidence_projection", "real_subprocess_crash_recovery_when_selected"]},
        "verification_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "VerificationFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract_version", "code", "path", "expected", "actual", "context", "failure_digest"],
      "properties": {
        "kind": {"const": "M4CILVerificationFailure"}, "schema_version": {"const": "flrh-m4cil-verification/1"}, "contract_version": {"const": "flrh-m4cil-integration/1"},
        "code": {"const": "EVIDENCE_MISMATCH"}, "path": {"type": "string", "pattern": "^/"},
        "expected": {"$ref": "#/$defs/Canonical"}, "actual": {"$ref": "#/$defs/Canonical"},
        "context": {"type": "object", "maxProperties": 0}, "failure_digest": {"$ref": "#/$defs/Digest"}
      }
    }
  }
}
