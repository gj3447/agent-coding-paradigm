{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-manifest.v1.schema.json",
  "title": "M2 stratified logic conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "normative_contracts",
    "inherited_normative_dependencies",
    "inherited_fixture_dependencies",
    "self_validating_schemas",
    "schema_bindings",
    "conformance_fixture",
    "golden_outputs",
    "reference_implementation",
    "non_normative_tools",
    "mechanics_tests",
    "completion_boundary"
  ],
  "properties": {
    "schema_version": {"const": "m2-manifest/v1"},
    "status": {
      "enum": ["PROPOSED_PENDING_MEASUREMENT", "MEASURED_REFERENCE_CONFORMANCE", "FALSIFIED"]
    },
    "normative_contracts": {
      "const": [
        "spec/m2-logic-contract.v1.json",
        "spec/schema/m2-logic.v1.schema.json",
        "spec/m2-manifest.v1.json"
      ]
    },
    "inherited_normative_dependencies": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/ProtocolDependency"},
        {"$ref": "#/$defs/CanonicalizationDependency"},
        {"$ref": "#/$defs/LogicSemanticsDependency"},
        {"$ref": "#/$defs/M1SchemaDependency"}
      ],
      "items": false
    },
    "inherited_fixture_dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"$ref": "#/$defs/M1GoldenDependency"}],
      "items": false
    },
    "self_validating_schemas": {
      "const": [
        "spec/schema/m2-logic.v1.schema.json",
        "spec/schema/m2-logic-contract.v1.schema.json",
        "spec/schema/m2-fixtures.v1.schema.json",
        "spec/schema/m2-manifest.v1.schema.json"
      ]
    },
    "schema_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "const": {
            "artifact": "spec/m2-logic-contract.v1.json",
            "schema": "spec/schema/m2-logic-contract.v1.schema.json"
          }
        },
        {
          "const": {
            "artifact": "spec/m2-manifest.v1.json",
            "schema": "spec/schema/m2-manifest.v1.schema.json"
          }
        },
        {
          "const": {
            "artifact": "fixtures/m2/cases.json",
            "schema": "spec/schema/m2-fixtures.v1.schema.json"
          }
        }
      ],
      "items": false
    },
    "conformance_fixture": {"const": "fixtures/m2/cases.json"},
    "golden_outputs": {
      "const": [
        "fixtures/m2/golden/two-support-retraction.fixpoint.json",
        "fixtures/m2/golden/negative-cycle.rejection.json"
      ]
    },
    "reference_implementation": {
      "const": [
        "src/flrh_logic/__init__.py",
        "src/flrh_logic/canonical.py",
        "src/flrh_logic/logic.py"
      ]
    },
    "non_normative_tools": {
      "const": [
        "scripts/m1_guard.py",
        "scripts/validate_m0.py",
        "scripts/m2_fixtures.py",
        "scripts/m2_oracle.py",
        "scripts/m2_guard.py",
        "scripts/check_m2_ambient.py",
        "scripts/run_m2_replay.py",
        "scripts/validate_m2.py",
        "tests/test_m2_logic.py"
      ]
    },
    "mechanics_tests": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "completion_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"type": "string"},
        "sha256": {"$ref": "#/$defs/Digest"}
      }
    },
    "ProtocolDependency": {
      "allOf": [
        {"$ref": "#/$defs/Dependency"},
        {"properties": {"artifact": {"const": "spec/schema/protocol.v1.schema.json"}}}
      ]
    },
    "CanonicalizationDependency": {
      "allOf": [
        {"$ref": "#/$defs/Dependency"},
        {"properties": {"artifact": {"const": "spec/canonicalization.v1.json"}}}
      ]
    },
    "LogicSemanticsDependency": {
      "allOf": [
        {"$ref": "#/$defs/Dependency"},
        {"properties": {"artifact": {"const": "spec/logic-semantics.v0.json"}}}
      ]
    },
    "M1SchemaDependency": {
      "allOf": [
        {"$ref": "#/$defs/Dependency"},
        {"properties": {"artifact": {"const": "spec/schema/m1-kernel.v1.schema.json"}}}
      ]
    },
    "M1GoldenDependency": {
      "allOf": [
        {"$ref": "#/$defs/Dependency"},
        {"properties": {"artifact": {"const": "fixtures/m1/golden/observe-with-effect.transition.json"}}}
      ]
    }
  }
}
