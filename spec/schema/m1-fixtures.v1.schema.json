{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m1-fixtures.v1.schema.json",
  "title": "M1 pure F-kernel conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_inputs",
    "success_cases",
    "rejection_cases",
    "equivalence_pairs",
    "replay_sequences",
    "sensitivity_mutations"
  ],
  "properties": {
    "schema_version": {"const": "m1-fixtures/v1"},
    "base_inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m1-kernel.v1.schema.json#/$defs/M1Input"
      }
    },
    "success_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/SuccessCase"}
    },
    "rejection_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/RejectionCase"}
    },
    "equivalence_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["left_case_id", "right_case_id"],
        "properties": {
          "left_case_id": {"$ref": "#/$defs/CaseId"},
          "right_case_id": {"$ref": "#/$defs/CaseId"}
        }
      }
    },
    "replay_sequences": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ReplaySequence"}
    },
    "sensitivity_mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input_ref", "mutation", "expected_relation"],
        "properties": {
          "id": {"$ref": "#/$defs/CaseId"},
          "input_ref": {"$ref": "#/$defs/CaseId"},
          "mutation": {"$ref": "#/$defs/Mutation"},
          "expected_relation": {"enum": ["different_transition", "typed_rejection"]},
          "identity_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^/"}
          }
        }
      }
    }
  },
  "$defs": {
    "CaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "Mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": {"enum": ["add", "replace", "remove"]},
        "path": {"type": "string", "pattern": "^/(snapshot|accepted_event)(/.*)?$"},
        "value": {}
      }
    },
    "Mutations": {
      "type": "array",
      "items": {"$ref": "#/$defs/Mutation"}
    },
    "SuccessCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_ref",
        "mutations",
        "expected_transition_digest",
        "expected_next_revision",
        "expected_next_phase",
        "expected_fact_delta_count",
        "expected_effect_proposal_count"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/CaseId"},
        "input_ref": {"$ref": "#/$defs/CaseId"},
        "mutations": {"$ref": "#/$defs/Mutations"},
        "expected_transition_digest": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Digest"
        },
        "expected_next_revision": {"type": "integer", "minimum": 1},
        "expected_next_phase": {"enum": ["open", "closed"]},
        "expected_fact_delta_count": {"type": "integer", "minimum": 1},
        "expected_effect_proposal_count": {"type": "integer", "minimum": 0}
      }
    },
    "RejectionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_ref",
        "mutations",
        "expected_code",
        "expected_path",
        "expected_context"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/CaseId"},
        "input_ref": {"$ref": "#/$defs/CaseId"},
        "mutations": {"$ref": "#/$defs/Mutations"},
        "expected_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "expected_path": {"type": "string", "pattern": "^/"},
        "expected_context": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer", "boolean", "null"]
          }
        }
      }
    },
    "ReplaySequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "initial_input_ref",
        "steps",
        "expected_transition_digests",
        "expected_final_revision"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/CaseId"},
        "initial_input_ref": {"$ref": "#/$defs/CaseId"},
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_ref", "event_mutations"],
            "properties": {
              "input_ref": {"$ref": "#/$defs/CaseId"},
              "event_mutations": {
                "type": "array",
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/Mutation"},
                    {
                      "type": "object",
                      "properties": {
                        "path": {"type": "string", "pattern": "^/accepted_event(/.*)?$"}
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "expected_transition_digests": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Digest"
          }
        },
        "expected_final_revision": {"type": "integer", "minimum": 2}
      }
    }
  }
}
