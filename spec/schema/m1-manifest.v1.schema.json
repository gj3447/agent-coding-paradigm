{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m1-manifest.v1.schema.json",
  "title": "M1 conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "normative_contracts",
    "inherited_normative_dependencies",
    "self_validating_schemas",
    "schema_bindings",
    "conformance_fixture",
    "golden_outputs",
    "reference_implementation",
    "non_normative_tools",
    "mechanics_tests",
    "completion_boundary"
  ],
  "properties": {
    "schema_version": {"const": "m1-manifest/v1"},
    "status": {
      "enum": ["PROPOSED_PENDING_MEASUREMENT", "MEASURED_REFERENCE_CONFORMANCE", "FALSIFIED"]
    },
    "normative_contracts": {"$ref": "#/$defs/Paths"},
    "inherited_normative_dependencies": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/ProtocolDependency"},
        {"$ref": "#/$defs/CanonicalizationDependency"}
      ],
      "items": false
    },
    "self_validating_schemas": {"$ref": "#/$defs/Paths"},
    "schema_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "schema"],
        "properties": {
          "artifact": {"$ref": "#/$defs/Path"},
          "schema": {"$ref": "#/$defs/Path"}
        }
      }
    },
    "conformance_fixture": {"$ref": "#/$defs/Path"},
    "golden_outputs": {"$ref": "#/$defs/Paths"},
    "reference_implementation": {"$ref": "#/$defs/Paths"},
    "non_normative_tools": {"$ref": "#/$defs/Paths"},
    "mechanics_tests": {"$ref": "#/$defs/Strings"},
    "completion_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "ProtocolDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"const": "spec/schema/protocol.v1.schema.json"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "CanonicalizationDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"const": "spec/canonicalization.v1.json"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "Path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
    "Paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/Path"}
    },
    "Strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
