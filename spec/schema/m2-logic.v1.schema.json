{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json",
  "title": "M2 stratified logic kernel wire objects",
  "oneOf": [
    {"$ref": "#/$defs/LRuleBundle"},
    {"$ref": "#/$defs/LFactDeltaInput"},
    {"$ref": "#/$defs/LMaterialization"},
    {"$ref": "#/$defs/LFixpointResult"},
    {"$ref": "#/$defs/LRejection"}
  ],
  "$defs": {
    "Id": {
      "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Id"
    },
    "Version": {
      "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Version"
    },
    "Digest": {
      "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Digest"
    },
    "LogicalTime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "CanonicalValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/CanonicalValue"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/CanonicalValue"}
        }
      ]
    },
    "Atom": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/CanonicalValue"}
    },
    "CanonicalObject": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/CanonicalValue"}
    },
    "Polarity": {"enum": ["positive", "negative"]},
    "TruthState": {"enum": ["NEITHER", "TRUE_ONLY", "FALSE_ONLY", "BOTH"]},
    "LLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "polarity", "atom"],
      "properties": {
        "kind": {"const": "LLiteral"},
        "polarity": {"$ref": "#/$defs/Polarity"},
        "atom": {"$ref": "#/$defs/Atom"}
      }
    },
    "LDefaultNotPositive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "atom", "referenced_stratum"],
      "properties": {
        "kind": {"const": "LDefaultNotPositive"},
        "atom": {"$ref": "#/$defs/Atom"},
        "referenced_stratum": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "LRule": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"properties": {"required_body": {"minItems": 1}}},
        {"properties": {"default_not_positive_body": {"minItems": 1}}}
      ],
      "required": [
        "kind",
        "rule_id",
        "stratum",
        "head",
        "required_body",
        "default_not_positive_body",
        "rule_digest"
      ],
      "properties": {
        "kind": {"const": "LRule"},
        "rule_id": {"$ref": "#/$defs/Id"},
        "stratum": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "head": {"$ref": "#/$defs/LLiteral"},
        "required_body": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LLiteral"}
        },
        "default_not_positive_body": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LDefaultNotPositive"}
        },
        "rule_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rule_firings", "max_derivation_depth"],
      "properties": {
        "max_rule_firings": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_derivation_depth": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "LRuleBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "contract_version",
        "profile_id",
        "rule_set_version",
        "dataflow_version",
        "canonicalization_version",
        "limits",
        "query_atoms",
        "rules",
        "rule_bundle_digest"
      ],
      "properties": {
        "kind": {"const": "LRuleBundle"},
        "schema_version": {"const": "flrh-l-rules/1"},
        "contract_version": {"const": "flrh-l-kernel/1"},
        "profile_id": {"const": "flrh-l-ground-stratified/1"},
        "rule_set_version": {"$ref": "#/$defs/Version"},
        "dataflow_version": {"$ref": "#/$defs/Version"},
        "canonicalization_version": {"const": "flrh-cjson/1"},
        "limits": {"$ref": "#/$defs/Limits"},
        "query_atoms": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Atom"}
        },
        "rules": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LRule"}
        },
        "rule_bundle_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "ExactFactDelta": {
      "allOf": [
        {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/FactDelta"
        },
        {
          "type": "object",
          "properties": {
            "tuple": {"$ref": "#/$defs/Atom"},
            "provenance_delta": {"$ref": "#/$defs/CanonicalObject"}
          }
        }
      ]
    },
    "LFactDeltaInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "polarity", "delta"],
      "properties": {
        "kind": {"const": "LFactDeltaInput"},
        "schema_version": {"const": "flrh-l-input/1"},
        "polarity": {"$ref": "#/$defs/Polarity"},
        "delta": {"$ref": "#/$defs/ExactFactDelta"}
      }
    },
    "LBaseSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "derivation_id",
        "support_content_digest",
        "literal",
        "provenance_delta",
        "rule_set_version",
        "dataflow_version"
      ],
      "properties": {
        "kind": {"const": "LBaseSupport"},
        "derivation_id": {"$ref": "#/$defs/Id"},
        "support_content_digest": {"$ref": "#/$defs/Digest"},
        "literal": {"$ref": "#/$defs/LLiteral"},
        "provenance_delta": {"$ref": "#/$defs/CanonicalObject"},
        "rule_set_version": {"$ref": "#/$defs/Version"},
        "dataflow_version": {"$ref": "#/$defs/Version"}
      }
    },
    "LAbsenceWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fact_key",
        "atom",
        "referenced_stratum",
        "completed_stratum_digest",
        "witness_digest"
      ],
      "properties": {
        "kind": {"const": "LAbsenceWitness"},
        "fact_key": {"$ref": "#/$defs/Digest"},
        "atom": {"$ref": "#/$defs/Atom"},
        "referenced_stratum": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "completed_stratum_digest": {"$ref": "#/$defs/Digest"},
        "witness_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "LDerivedSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "derivation_id",
        "support_content_digest",
        "literal",
        "rule_id",
        "rule_digest",
        "premise_literal_keys",
        "default_absence_witnesses",
        "rule_set_version",
        "dataflow_version"
      ],
      "properties": {
        "kind": {"const": "LDerivedSupport"},
        "derivation_id": {"$ref": "#/$defs/Id"},
        "support_content_digest": {"$ref": "#/$defs/Digest"},
        "literal": {"$ref": "#/$defs/LLiteral"},
        "rule_id": {"$ref": "#/$defs/Id"},
        "rule_digest": {"$ref": "#/$defs/Digest"},
        "premise_literal_keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Digest"}
        },
        "default_absence_witnesses": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LAbsenceWitness"}
        },
        "rule_set_version": {"$ref": "#/$defs/Version"},
        "dataflow_version": {"$ref": "#/$defs/Version"}
      }
    },
    "LFactState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fact_key", "atom", "state", "positive_support_ids", "negative_support_ids"],
      "properties": {
        "kind": {"const": "LFactState"},
        "fact_key": {"$ref": "#/$defs/Digest"},
        "atom": {"$ref": "#/$defs/Atom"},
        "state": {"$ref": "#/$defs/TruthState"},
        "positive_support_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Id"}
        },
        "negative_support_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Id"}
        }
      }
    },
    "LConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "conflict_id", "fact_key", "atom", "positive_support_ids", "negative_support_ids"],
      "properties": {
        "kind": {"const": "LConflict"},
        "conflict_id": {"$ref": "#/$defs/Id"},
        "fact_key": {"$ref": "#/$defs/Digest"},
        "atom": {"$ref": "#/$defs/Atom"},
        "positive_support_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Id"}
        },
        "negative_support_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Id"}
        }
      }
    },
    "LStratumDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stratum", "digest"],
      "properties": {
        "kind": {"const": "LStratumDigest"},
        "stratum": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "LMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "contract_version",
        "profile_id",
        "rule_bundle_digest",
        "rule_set_version",
        "dataflow_version",
        "canonicalization_version",
        "through_logical_time",
        "base_supports",
        "derived_supports",
        "fact_states",
        "conflicts",
        "stratum_digests",
        "materialization_digest"
      ],
      "properties": {
        "kind": {"const": "LMaterialization"},
        "schema_version": {"const": "flrh-l-materialization/1"},
        "contract_version": {"const": "flrh-l-kernel/1"},
        "profile_id": {"const": "flrh-l-ground-stratified/1"},
        "rule_bundle_digest": {"$ref": "#/$defs/Digest"},
        "rule_set_version": {"$ref": "#/$defs/Version"},
        "dataflow_version": {"$ref": "#/$defs/Version"},
        "canonicalization_version": {"const": "flrh-cjson/1"},
        "through_logical_time": {
          "oneOf": [
            {"$ref": "#/$defs/LogicalTime"},
            {"type": "null"}
          ]
        },
        "base_supports": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LBaseSupport"}
        },
        "derived_supports": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LDerivedSupport"}
        },
        "fact_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LFactState"}
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LConflict"}
        },
        "stratum_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LStratumDigest"}
        },
        "materialization_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "LStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "rule_evaluation_count",
        "rule_firing_count",
        "worklist_pop_count",
        "max_derivation_depth"
      ],
      "properties": {
        "evaluation_mode": {"const": "full_recompute"},
        "rule_evaluation_count": {"type": "integer", "minimum": 0},
        "rule_firing_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "worklist_pop_count": {"type": "integer", "minimum": 0},
        "max_derivation_depth": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "LFixpointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "contract_version",
        "logical_time",
        "rule_bundle_digest",
        "prior_materialization_digest",
        "input_delta_digests",
        "next_materialization",
        "derived_fact_deltas",
        "stats",
        "fixpoint_digest"
      ],
      "properties": {
        "kind": {"const": "LFixpointResult"},
        "schema_version": {"const": "flrh-l-result/1"},
        "contract_version": {"const": "flrh-l-kernel/1"},
        "logical_time": {"$ref": "#/$defs/LogicalTime"},
        "rule_bundle_digest": {"$ref": "#/$defs/Digest"},
        "prior_materialization_digest": {
          "oneOf": [
            {"$ref": "#/$defs/Digest"},
            {"type": "null"}
          ]
        },
        "input_delta_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Digest"}
        },
        "next_materialization": {"$ref": "#/$defs/LMaterialization"},
        "derived_fact_deltas": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LFactDeltaInput"}
        },
        "stats": {"$ref": "#/$defs/LStats"},
        "fixpoint_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "RejectionCode": {
      "enum": [
        "MALFORMED_MATERIALIZATION",
        "MALFORMED_RULE_BUNDLE",
        "MALFORMED_FACT_DELTA_INPUT",
        "CANONICALIZATION_VIOLATION",
        "UNSUPPORTED_CONTRACT_VERSION",
        "UNSUPPORTED_PROFILE",
        "UNSUPPORTED_MATERIALIZATION_SCHEMA",
        "UNSUPPORTED_RULE_SCHEMA",
        "UNSUPPORTED_INPUT_SCHEMA",
        "UNSUPPORTED_CANONICALIZATION",
        "RULE_SET_VERSION_MISMATCH",
        "DATAFLOW_VERSION_MISMATCH",
        "RULE_BUNDLE_MISMATCH",
        "LOGICAL_TIME_MISMATCH",
        "LOGICAL_TIME_REGRESSION",
        "INVALID_STRATIFICATION",
        "OUTSIDE_V0_NEGATIVE_RECURSION",
        "AMBIGUOUS_BATCH_DELTA",
        "UNKNOWN_DERIVATION",
        "DERIVATION_IDENTITY_CONFLICT",
        "DERIVED_SUPPORT_TARGET",
        "PROVENANCE_INTEGRITY_VIOLATION",
        "RULE_BUDGET_EXHAUSTED",
        "DERIVATION_DEPTH_EXCEEDED",
        "INVARIANT_VIOLATION"
      ]
    },
    "RejectionContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {"$ref": "#/$defs/CanonicalValue"},
        "actual": {"$ref": "#/$defs/CanonicalValue"},
        "derivation_id": {"$ref": "#/$defs/Id"},
        "rule_id": {"$ref": "#/$defs/Id"},
        "invariant": {"type": "string", "minLength": 1},
        "limit": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0},
        "source_stratum": {"type": "integer", "minimum": 0},
        "target_stratum": {"type": "integer", "minimum": 0},
        "support_content_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "LRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "contract_version",
        "code",
        "path",
        "logical_time",
        "rule_bundle_digest",
        "context"
      ],
      "properties": {
        "kind": {"const": "LRejection"},
        "schema_version": {"const": "flrh-l-result/1"},
        "contract_version": {"const": "flrh-l-kernel/1"},
        "code": {"$ref": "#/$defs/RejectionCode"},
        "path": {"type": "string", "pattern": "^(/([^/~]|~[01])*)*$"},
        "logical_time": {
          "oneOf": [
            {"$ref": "#/$defs/LogicalTime"},
            {"type": "null"}
          ]
        },
        "rule_bundle_digest": {
          "oneOf": [
            {"$ref": "#/$defs/Digest"},
            {"type": "null"}
          ]
        },
        "context": {"$ref": "#/$defs/RejectionContext"}
      }
    }
  }
}
