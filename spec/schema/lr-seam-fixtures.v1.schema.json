{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/lr-seam-fixtures.v1.schema.json",
  "title": "Direct L to R seam closed conformance descriptor",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "binding_profile", "rule_bundle", "r_profile", "l_results", "query_batches", "success_cases", "rejection_cases", "equivalence_pairs", "goldens"],
  "properties": {
    "schema_version": {"const": "lr-seam-fixtures/1"},
    "binding_profile": {"$ref": "#/$defs/BuildProfile"},
    "rule_bundle": {"$ref": "#/$defs/BuildRuleBundle"},
    "r_profile": {"$ref": "#/$defs/BuildRProfile"},
    "l_results": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/Id"}, "additionalProperties": {"$ref": "#/$defs/LResultDescriptor"}},
    "query_batches": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/Id"}, "additionalProperties": {"$ref": "#/$defs/QueryBatchDescriptor"}},
    "success_cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/SuccessCase"}},
    "rejection_cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/RejectionCase"}},
    "equivalence_pairs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/EquivalencePair"}},
    "goldens": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/Golden"}}
  },
  "$defs": {
    "Id": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Id"},
    "Version": {"$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Version"},
    "BuildProfile": {
      "type": "object", "additionalProperties": false, "required": ["factory", "kwargs"],
      "properties": {
        "factory": {"const": "materialize_binding_profile"},
        "kwargs": {
          "type": "object", "additionalProperties": false,
          "required": ["rule_set_version", "dataflow_version", "max_queries", "max_fact_requirements_per_query"],
          "properties": {
            "rule_set_version": {"$ref": "#/$defs/Version"}, "dataflow_version": {"$ref": "#/$defs/Version"},
            "max_queries": {"type": "integer", "minimum": 1, "maximum": 1024},
            "max_fact_requirements_per_query": {"type": "integer", "minimum": 1, "maximum": 64}
          }
        }
      }
    },
    "BuildRuleBundle": {
      "type": "object", "additionalProperties": false, "required": ["factory", "fixture_id", "logical_time"],
      "properties": {"factory": {"const": "truth_fixture_inputs"}, "fixture_id": {"$ref": "#/$defs/Id"}, "logical_time": {"$ref": "#/$defs/LogicalTime"}}
    },
    "BuildRProfile": {
      "type": "object", "additionalProperties": false, "required": ["factory", "kwargs"],
      "properties": {
        "factory": {"const": "materialize_r_profile"},
        "kwargs": {
          "type": "object", "additionalProperties": false, "required": ["dataflow_version", "max_deltas_per_command"],
          "properties": {"dataflow_version": {"$ref": "#/$defs/Version"}, "max_deltas_per_command": {"type": "integer", "minimum": 1, "maximum": 10000}}
        }
      }
    },
    "LResultDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["factory", "prior_materialization", "rule_bundle_ref", "fact_delta_set", "logical_time"],
      "properties": {
        "factory": {"const": "solve_l"}, "prior_materialization": {"type": "null"}, "rule_bundle_ref": {"$ref": "#/$defs/Id"},
        "fact_delta_set": {"enum": ["truth-four-supports", "m1-observe-with-effect"]}, "logical_time": {"$ref": "#/$defs/LogicalTime"}
      }
    },
    "QueryBatchDescriptor": {
      "oneOf": [
        {"$ref": "#/$defs/TruthQueryBatch"}, {"$ref": "#/$defs/LimitQueryBatch"}, {"$ref": "#/$defs/PermutationQueryBatch"}, {"$ref": "#/$defs/M1ChainQueryBatch"}
      ]
    },
    "TruthQueryBatch": {
      "type": "object", "additionalProperties": false, "required": ["factory", "truth_cases"],
      "properties": {
        "factory": {"enum": ["eligible_golden", "truth_matrix", "multi_aggregation", "empty_query_batch"]},
        "truth_cases": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/TruthCase"}}
      }
    },
    "LimitQueryBatch": {
      "type": "object", "additionalProperties": false, "required": ["factory", "count"],
      "properties": {"factory": {"const": "query_limit"}, "count": {"type": "integer", "minimum": 0, "maximum": 1024}}
    },
    "PermutationQueryBatch": {
      "type": "object", "additionalProperties": false, "required": ["factory", "variant"],
      "properties": {"factory": {"const": "permutation"}, "variant": {"enum": ["canonical", "reversed_queries_requirements_and_nested_sets"]}}
    },
    "M1ChainQueryBatch": {
      "type": "object", "additionalProperties": false, "required": ["factory", "fact_precondition_ids", "frontier_precondition_ids"],
      "properties": {
        "factory": {"const": "m1_chain"},
        "fact_precondition_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "frontier_precondition_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}}
      }
    },
    "ExpectedSource": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"const": "oracle"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "path"], "properties": {"source": {"const": "golden"}, "path": {"type": "string", "pattern": "^fixtures/lr-seam/golden/[A-Za-z0-9._-]+\\.json$"}}}
      ]
    },
    "SuccessCase": {
      "type": "object", "additionalProperties": false, "required": ["id", "l_result_ref", "query_batch_ref", "expected"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "l_result_ref": {"$ref": "#/$defs/Id"}, "query_batch_ref": {"$ref": "#/$defs/Id"}, "expected": {"$ref": "#/$defs/ExpectedSource"}}
    },
    "RejectionCase": {
      "type": "object", "additionalProperties": false, "required": ["id", "mutation", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "mutation": {"enum": ["orphan_precondition", "fact_frontier_overlap", "duplicate_requirement_precondition", "undeclared_query_atom", "query_batch_digest_flip", "proposal_rule_version_mismatch", "duplicate_proposal_id", "max_queries_plus_one", "max_requirements_plus_one", "exact_partition_mismatch", "rule_bundle_digest_flip", "l_fixpoint_digest_flip", "r_profile_digest_flip", "binding_profile_digest_flip", "binding_dataflow_version_mismatch", "query_binding_digest_flip", "canonical_float_in_query", "remove_declared_neither_fact_and_redigest_l", "redigest_l_with_derived_fact_delta_string", "redigest_l_with_rule_firing_count_1001", "diagnostic_query_order_left", "diagnostic_query_order_right", "diagnostic_nested_requirement_order_left", "diagnostic_nested_requirement_order_right"]},
        "expected": {"$ref": "lr-seam.v1.schema.json#/$defs/LRProjectionRejection"}
      }
    },
    "EquivalencePair": {
      "type": "object", "additionalProperties": false, "required": ["id", "left_success_case_ref", "right_success_case_ref", "comparison"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "left_success_case_ref": {"$ref": "#/$defs/Id"}, "right_success_case_ref": {"$ref": "#/$defs/Id"}, "comparison": {"enum": ["projection_digest", "command_bytes", "full_result_bytes"]}}
    },
    "Golden": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "kind"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "path": {"enum": ["fixtures/lr-seam/golden/eligible.projection.json", "fixtures/lr-seam/golden/mismatch.rejection.json"]}, "kind": {"enum": ["LRProjectionResult", "LRProjectionRejection"]}}
    },
    "TruthCase": {"enum": ["positive_TRUE_ONLY", "positive_FALSE_ONLY", "positive_BOTH", "positive_NEITHER", "negative_TRUE_ONLY", "negative_FALSE_ONLY", "positive_TRUE_ONLY+negative_FALSE_ONLY", "positive_TRUE_ONLY+positive_BOTH"]},
    "LogicalTime": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
  }
}
