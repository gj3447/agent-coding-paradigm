{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-fixtures.v1.schema.json",
  "title": "M2 stratified logic conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "m1_positive_seam",
    "atoms",
    "base_fact_delta_inputs",
    "base_rule_bundles",
    "success_cases",
    "rejection_cases",
    "sequences",
    "equivalence_pairs"
  ],
  "properties": {
    "schema_version": {"const": "m2-fixtures/1"},
    "m1_positive_seam": {
      "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/FactDelta"
    },
    "atoms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/Atom"
      }
    },
    "base_fact_delta_inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/FactDeltaTemplate"}
    },
    "base_rule_bundles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/RuleBundleTemplate"}
    },
    "success_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/SuccessCase"}
    },
    "rejection_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/RejectionCase"}
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Sequence"}
    },
    "equivalence_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/EquivalencePair"}
    }
  },
  "$defs": {
    "Name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "CaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "DeltaRef": {
      "type": "string",
      "pattern": "^(\\$m1_positive_seam|[a-z0-9][a-z0-9_-]*)$"
    },
    "AtomRef": {"$ref": "#/$defs/Name"},
    "FactDeltaTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_ref", "polarity", "diff", "derivation_id"],
      "properties": {
        "atom_ref": {"$ref": "#/$defs/AtomRef"},
        "polarity": {"enum": ["positive", "negative"]},
        "diff": {"enum": [-1, 1]},
        "derivation_id": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Id"
        },
        "provenance_delta": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/CanonicalObject"
        }
      }
    },
    "LiteralTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_ref", "polarity"],
      "properties": {
        "atom_ref": {"$ref": "#/$defs/AtomRef"},
        "polarity": {"enum": ["positive", "negative"]}
      }
    },
    "DefaultTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_ref", "referenced_stratum"],
      "properties": {
        "atom_ref": {"$ref": "#/$defs/AtomRef"},
        "referenced_stratum": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "RuleTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "stratum", "head", "required", "default_not_positive"],
      "properties": {
        "rule_id": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Id"
        },
        "stratum": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "head": {"$ref": "#/$defs/LiteralTemplate"},
        "required": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/LiteralTemplate"}
        },
        "default_not_positive": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/DefaultTemplate"}
        }
      }
    },
    "RuleBundleTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "query_atom_refs", "rules"],
      "properties": {
        "rule_set_version": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Version"
        },
        "dataflow_version": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/protocol.v1.schema.json#/$defs/Version"
        },
        "limits": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/Limits"
        },
        "query_atom_refs": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/AtomRef"}
        },
        "rules": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/RuleTemplate"}
        }
      }
    },
    "StateMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/TruthState"
      }
    },
    "CountMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "SuccessCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundle_ref", "delta_refs", "expected_states"],
      "properties": {
        "id": {"$ref": "#/$defs/CaseId"},
        "bundle_ref": {"$ref": "#/$defs/Name"},
        "delta_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/DeltaRef"}
        },
        "expected_states": {"$ref": "#/$defs/StateMap"},
        "expected_positive_support_counts": {"$ref": "#/$defs/CountMap"},
        "expected_negative_support_counts": {"$ref": "#/$defs/CountMap"}
      }
    },
    "RejectionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundle_ref", "delta_refs", "expected_code", "expected_path", "expected_rule_bundle_digest", "expected_context"],
      "properties": {
        "id": {"$ref": "#/$defs/CaseId"},
        "bundle_ref": {"$ref": "#/$defs/Name"},
        "delta_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/DeltaRef"}
        },
        "expected_code": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/RejectionCode"
        },
        "expected_path": {"type": "string", "pattern": "^(/([^/~]|~[01])*)*$"},
        "expected_rule_bundle_digest": {
          "oneOf": [
            {"const": "supplied"},
            {"type": "null"}
          ]
        },
        "expected_context": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/RejectionContext"
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/Mutation"}
        }
      }
    },
    "Mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "path", "value"],
      "properties": {
        "target": {"enum": ["rule_bundle", "fact_delta_inputs"]},
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "integer", "minimum": 0}
            ]
          }
        },
        "value": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/CanonicalValue"
        }
      }
    },
    "ExpectedRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_code", "expected_path", "expected_rule_bundle_digest", "expected_context"],
      "properties": {
        "expected_code": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/RejectionCode"
        },
        "expected_path": {"type": "string", "pattern": "^(/([^/~]|~[01])*)*$"},
        "expected_rule_bundle_digest": {
          "oneOf": [
            {"const": "supplied"},
            {"type": "null"}
          ]
        },
        "expected_context": {
          "$ref": "https://github.com/gj3447/agent-coding-paradigm/spec/schema/m2-logic.v1.schema.json#/$defs/RejectionContext"
        }
      }
    },
    "Sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundle_ref", "steps"],
      "properties": {
        "id": {"$ref": "#/$defs/CaseId"},
        "bundle_ref": {"$ref": "#/$defs/Name"},
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/DeltaRef"}
          }
        },
        "expected_terminal_rejection": {"$ref": "#/$defs/ExpectedRejection"}
      }
    },
    "EquivalencePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundle_ref", "delta_refs", "reverse_rules", "reverse_deltas"],
      "properties": {
        "id": {"$ref": "#/$defs/CaseId"},
        "bundle_ref": {"$ref": "#/$defs/Name"},
        "delta_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/DeltaRef"}
        },
        "reverse_rules": {"type": "boolean"},
        "reverse_deltas": {"type": "boolean"}
      }
    }
  }
}
